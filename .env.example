PORT=3189
# Address vite preview listens on. Loopback keeps it reachable only through the
# reverse proxy; set 0.0.0.0 to open it to the LAN on a machine without one.
BIND=127.0.0.1
PM2_NAME=timer

# Public hostname(s) this timer is served from, e.g. timer.gcc3.com.
# Comma-separate more than one. Vite refuses requests carrying a Host header it
# was not told about, so a deploy behind a reverse proxy must list its name here.
# Leave empty for local development.
HOST=
